<Window x:Class="FocusApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FocusApp"
        mc:Ignorable="d"
        Loaded="WindowLoaded"
        Closing="WindowClosing"
        Title="MainWindow" Height="450" Width="800">
    <Viewbox Stretch="Uniform">

        <Grid>
            <Image x:Name="WebcamViewer" Stretch="Uniform" Margin="0,0,0,100"/>
            <Button Content="Activate/Deactivate Watcher" HorizontalAlignment="Left" Margin="250,511,0,0" VerticalAlignment="Top" Click="ChnageUseState"/>

        </Grid>
    </Viewbox>
</Window>
